                    <displayName>DBG</displayName>
                    <description>System DBG Control Register</description>
                    <addressOffset>0x4</addressOffset>
                    <size>0x20</size>
                    <access>read-write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>ATIM_DBG</name>
                            <description>In DEBUG mode, ATIM counting method</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>GTIM_DBG</name>
                            <description>In DEBUG mode, GTIM counting method</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>BTIM0_DBG</name>
                            <description>In DEBUG mode, BTIM0 counting method</description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>BTIM1_DBG</name>
                            <description>In DEBUG mode, BTIM1 counting method</description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>LPTIM_DBG</name>
                            <description>In DEBUG mode, LPTIM counting method</description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>IWDT_DBG</name>
                            <description>In DEBUG mode, IWDT counting method</description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>WWDT_DBG</name>
                            <description>In DEBUG mode, WWDT counting method</description>
                            <bitOffset>7</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TRIMKEY</name>
                    <displayName>TRIMKEY</displayName>
                    <description>SCU Test Read/Write Protection Register </description>
                    <addressOffset>0x100</addressOffset>
                    <size>0x20</size>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>TRIM_LOCKKEY</name>
                            <description> Password protection configuration for testing register read/write operations Write 0xa5a5 to unlock, while setting SCU_KEYST to 1 Write any other value to lock, while clearing SCU_KEYST to 0 </description>
                            <bitRange>[15:0]</bitRange>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>TRIM_KEYST</name>
                            <description>Test register read/write protection flag</description>
                            <bitRange>[16:16]</bitRange>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>VERSION</name>
                    <displayName>VERSION</displayName>
                    <description>VERSION</description>
                    <addressOffset>0x130</addressOffset>
                    <size>0x20</size>
                    <access>read-only</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>VERSION</name>
                            <description>VERSION</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
