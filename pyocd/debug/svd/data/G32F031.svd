<?xml version="1.0" encoding="utf-8"?>
<device xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.3" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
    <name>G32F031</name>
    <version>1.0</version>
    <description>G32F031</description>
    <!-- details about the cpu embedded in the device -->
    <cpu>
        <name>CM0PLUS</name>
        <revision>r0p1</revision>
        <endian>little</endian>
        <mpuPresent>false</mpuPresent>
        <fpuPresent>false</fpuPresent>
        <nvicPrioBits>2</nvicPrioBits>
        <vendorSystickConfig>false</vendorSystickConfig>
    </cpu>
    <!--Bus Interface Properties-->
    <!--Cortex-M0PLUS is byte addressable-->
    <addressUnitBits>8</addressUnitBits>
    <!--the maximum data bit width accessible within a single transfer-->
    <width>32</width>
    <!--Register Default Properties-->
    <size>0x20</size>
    <resetValue>0x0</resetValue>
    <resetMask>0xFFFFFFFF</resetMask>
    <peripherals>
        <peripheral>
            <name>PMU</name>
            <description>Power Manage Unit</description>
            <groupName>PMU</groupName>
            <baseAddress>0x40000000</baseAddress>
            <addressBlock>
                <offset>0x0</offset>
                <size>0x400</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>
                <name>PVD</name>
                <description>PVD global interrupt</description>
                <value>1</value>
            </interrupt>
            <registers>
                <register>
                    <name>KEY</name>
                    <displayName>KEY</displayName>
                    <description>Read-Write Protection Register</description>
                    <addressOffset>0x0</addressOffset>
                    <size>0x20</size>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>LOCKKEY</name>
                            <description>Counter enable</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>16</bitWidth>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>KEYST</name>
                            <description>Update disable</description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>1</bitWidth>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LPMCR</name>
                    <displayName>LPMCR</displayName>
                    <description>Low Power Mode Register</description>
                    <addressOffset>0x4</addressOffset>
                    <size>0x20</size>
                    <access>read-write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>LPM</name>
                            <description>Low Power Mode</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>STANDBY_MODE</name>
                            <description>STANDBY Operation Mode</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>WKPCR</name>
                    <displayName>WKPCR</displayName>
                    <description>Low-power wake-up control register</description>
                    <addressOffset>0x8</addressOffset>
                    <size>0x20</size>
                    <access>read-write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>WKUPEN0</name>
                            <description>Enable wake-up from STANDBY by pin 0</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>WKUPEN1</name>
                            <description>Enable wake-up from STANDBY by pin 1</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>WKUPPOL0</name>
                            <description>Wake-up polarity of pin 0 for STANDBY</description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>2</bitWidth>
                        </field>
                        <field>
                            <name>WKUPPOL1</name>
                            <description>Wake-up polarity of pin 1 for STANDBY</description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>2</bitWidth>
                        </field>
                        <field>
                            <name>WKUPPULL0</name>
                            <description>Wake-up pin 0 pull-up/pull-down control in STANDBY mode</description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>2</bitWidth>
                        </field>
                        <field>
                            <name>WKUPPULL1</name>
                            <description>Wake-up pin 1 pull-up/pull-down control in STANDBY mode</description>
                            <bitOffset>18</bitOffset>
                            <bitWidth>2</bitWidth>
                        </field>
                        <field>
                            <name>IWDT_WKUPEN</name>
                            <description>Enable IWDT wake-up in STANDBY mode</description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>LPTIM_WKUPEN</name>
                            <description>Enable LPTIM wake-up in STANDBY mode</description>
                            <bitOffset>25</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>WKPSR</name>
                    <displayName>WKPSR</displayName>
                    <description>Low Power Wake-up Status Register</description>
                    <addressOffset>0xC</addressOffset>
                    <size>0x20</size>
                    <access>read-write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>WKUPF0</name>
                            <description>Wake-up pin 0 to STANDBY wake-up flag</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>WKUPF1</name>
                            <description>Wake-up pin 1 to STANDBY wake-up flag</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>SBF</name>
                            <description>STANDBY Event Flag </description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>IWDT_WKUPF</name>
                            <description>IWDT Standby Wake-up Flag</description>
                            <bitOffset>24</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>LPTIM_WKUPF</name>
                            <description>LPTIM to STANDBY wake-up flag</description>
                            <bitOffset>25</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PVDCSR</name>
                    <displayName>PVDCSR</displayName>
                    <description>PVD Control/Status Register </description>
                    <addressOffset>0x10</addressOffset>
                    <size>0x20</size>
                    <access>read-write</access>
                    <resetValue>0x0000</resetValue>
                    <fields>
                        <field>
                            <name>PVD_EN</name>
                            <description>PVD Enable</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>PVDTHSEL</name>
                            <description>PVD threshold voltage configuration</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>3</bitWidth>
                        </field>
                        <field>
                            <name>PVD_LT</name>
                            <description>PVD below threshold voltage event detection.</description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>PVD_HT</name>
                            <description>PVD above threshold voltage event monitoring.</description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>PVD_IE</name>
                            <description>PVD monitoring event interrupt enable</description>
                            <bitOffset>8</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>PVD_FLT_EN</name>
                            <description>PVD filter enable</description>
                            <bitOffset>9</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>PVD_FLT_SEL</name>
                            <description>PVD filter length select</description>
                            <bitOffset>10</bitOffset>
                            <bitWidth>3</bitWidth>
                        </field>
                        <field>
                            <name>PVDF</name>
                            <description>PVD Monitoring Event Flag </description>
                            <bitOffset>14</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>PVDO</name>
                            <description>PVD Monitoring Results Output</description>
                            <bitOffset>15</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>PVD_RDY</name>
                            <description>PVD Ready</description>
                            <bitOffset>16</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral>
            <name>SCU</name>
            <description>System Control Unit</description>
            <groupName>SCU</groupName>
            <baseAddress>0x40000400</baseAddress>
            <addressBlock>
                <offset>0x0</offset>
